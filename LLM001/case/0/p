FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    pumpA_outlet
    {
        type        fixedValue;
        value       uniform 0;
    }

    pumpB_inlet
    {
        type        zeroGradient;
    }

    pumpWall
    {
        type        zeroGradient;
    }

    topWall
    {
        type        zeroGradient;
    }

    bottom
    {
        type        zeroGradient;
    }

    sideWall
    {
        type        zeroGradient;
    }

    frontWall
    {
        type        zeroGradient;
    }

}
